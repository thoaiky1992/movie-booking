# Local development settings. Loaded automatically by godotenv in every binary.
APP_ENV=local
LOG_LEVEL=debug
HTTP_ADDR=:8080

DATABASE_URL=postgres://movie:movie@localhost:5432/movie?sslmode=disable
DB_MAX_CONNS=20

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

KAFKA_BROKERS=localhost:9092
KAFKA_BOOKING_TOPIC=booking.events
KAFKA_NOTIFICATION_DLQ_TOPIC=notification.dlq
KAFKA_NOTIFICATION_GROUP=notification-service

CURRENCY=VND
SEAT_HOLD_TTL=10m
MAX_SEATS_PER_BOOKING=10

# Mocks: payment charges succeed unless this is true; emails and rating partners are logged.
MOCK_PAYMENT_DECLINE_ALL=false

RATING_CACHE_TTL=12h
RATING_SYNC_INTERVAL=1h
RATING_READ_BUDGET=80ms
PARTNER_TIMEOUT=500ms

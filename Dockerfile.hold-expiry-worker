FROM golang:1.27 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/movie-booking .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/movie-booking /movie-booking
ENTRYPOINT ["/movie-booking", "worker", "hold-expiry"]
